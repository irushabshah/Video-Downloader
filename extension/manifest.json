{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "0.1.0",
  "description": "Download videos from YouTube, X, Instagram, TikTok and 1,800+ other sites. Runs locally with yt-dlp.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging", "downloads", "storage", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Video Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
